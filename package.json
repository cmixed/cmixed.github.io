{
  "name": "cmixed-homepage",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prepare": "vp hooks enable --hooks-dir .husky",
    "dev": "vp dev",
    "blog": "tsx blog/build-hljs.ts && tsx blog/build.ts",
    "nook": "tsx nook/build.ts",
    "build": "tsx scripts/optimize-images.ts && vp build && tsx blog/build-hljs.ts && tsx blog/build.ts && tsx nook/build.ts",
    "preview": "vp preview",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "optimize-images": "tsx scripts/optimize-images.ts"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "marked": "^18.0.10",
    "mermaid": "^11.17.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "5.0.5"
  }
}
