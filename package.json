{
  "name": "cmixed-homepage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "blog": "tsx blog/build.ts",
    "build": "tsc --noEmit && tsx scripts/optimize-images.ts && vite build && tsx blog/build.ts",
    "preview": "vite preview",
    "lint": "eslint src/ blog/build.ts",
    "lint:fix": "eslint src/ blog/build.ts --fix",
    "format": "prettier --write 'src/**/*.ts' 'blog/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'blog/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "optimize-images": "tsx scripts/optimize-images.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "marked": "^18.0.10",
    "mermaid": "^11.17.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^4.1.11"
  }
}
