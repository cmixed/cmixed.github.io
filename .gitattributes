# All text files use LF in both the repository and the working tree.
* text=auto eol=lf

# Binary assets: never apply any newline conversion.
*.avif binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.gz binary
*.br binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
*.webm binary

# Windows-only scripts would need CRLF; uncomment if they are ever added.
# *.bat text eol=crlf
# *.cmd text eol=crlf
# *.ps1 text eol=crlf
